<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/textRowRank"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="4" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="72dp"
            android:layout_height="104dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/imageRowCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Portada"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textRowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Fullmetal Alchemist: Brotherhood" />

            <TextView
                android:id="@+id/textRowMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="TV · 2009 · 64 eps" />

            <TextView
                android:id="@+id/textRowGenres"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/accent"
                android:textSize="12sp"
                tools:text="Acción · Aventura · Drama" />

            <TextView
                android:id="@+id/textRowScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/gold"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="★ 9.10" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imageRowHeart"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Agregar a favoritos"
            android:padding="10dp"
            android:src="@drawable/ic_favorite_border" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
