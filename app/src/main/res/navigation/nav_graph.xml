<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- Las 4 pestañas de la barra inferior -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.animeapp.HomeFragment"
        android:label="Inicio"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.animeapp.SearchFragment"
        android:label="Buscar"
        tools:layout="@layout/fragment_search" />

    <fragment
        android:id="@+id/topFragment"
        android:name="com.example.animeapp.TopFragment"
        android:label="Top ratings"
        tools:layout="@layout/fragment_top" />

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.example.animeapp.FavoritesFragment"
        android:label="Favoritos"
        tools:layout="@layout/fragment_favorites" />

    <!-- Detalle (Jetpack Compose): se puede abrir desde cualquier pestaña -->
    <fragment
        android:id="@+id/animeDetailFragment"
        android:name="com.example.animeapp.AnimeDetailFragment"
        android:label="Detalle" />

    <action
        android:id="@+id/action_global_animeDetail"
        app:destination="@id/animeDetailFragment" />

</navigation>
